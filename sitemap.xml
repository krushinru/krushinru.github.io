---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign documents = site.pages | concat: site.posts | concat: site.projects -%}
{%- for document in documents -%}
{%- assign include_document = true -%}
{%- if document.sitemap == false -%}
  {%- assign include_document = false -%}
{%- endif -%}
{%- if document.feature and site.features[document.feature] != true -%}
  {%- assign include_document = false -%}
{%- endif -%}
{%- if document.lang and include_document %}
  <url>
    <loc>{{ document.url | absolute_url | replace: '/index.html', '/' }}</loc>
    {%- if document.date %}
    <lastmod>{{ document.date | date_to_xmlschema }}</lastmod>
    {%- endif -%}
    {%- if document.translation_key -%}
      {%- for lang_code in site.languages -%}
        {%- assign alternate_url = '' -%}
        {%- for alt_doc in documents -%}
          {%- assign include_alternate = true -%}
          {%- if alt_doc.sitemap == false -%}
            {%- assign include_alternate = false -%}
          {%- endif -%}
          {%- if alt_doc.feature and site.features[alt_doc.feature] != true -%}
            {%- assign include_alternate = false -%}
          {%- endif -%}
          {%- if alt_doc.translation_key == document.translation_key and alt_doc.lang == lang_code and include_alternate -%}
            {%- assign alternate_url = alt_doc.url -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if alternate_url != '' %}
    <xhtml:link rel="alternate" hreflang="{{ lang_code }}" href="{{ alternate_url | absolute_url | replace: '/index.html', '/' }}" />
        {%- endif -%}
      {%- endfor -%}
      {%- assign default_alternate_url = '' -%}
      {%- for alt_doc in documents -%}
        {%- assign include_default_alternate = true -%}
        {%- if alt_doc.sitemap == false -%}
          {%- assign include_default_alternate = false -%}
        {%- endif -%}
        {%- if alt_doc.feature and site.features[alt_doc.feature] != true -%}
          {%- assign include_default_alternate = false -%}
        {%- endif -%}
        {%- if alt_doc.translation_key == document.translation_key and alt_doc.lang == site.default_lang and include_default_alternate -%}
          {%- assign default_alternate_url = alt_doc.url -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if default_alternate_url != '' %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ default_alternate_url | absolute_url | replace: '/index.html', '/' }}" />
      {%- endif -%}
    {%- endif %}
  </url>
{%- endif -%}
{%- endfor -%}
{%- for game in site.data.games %}
  <url>
    <loc>{{ game.url | absolute_url }}</loc>
  </url>
{%- endfor %}
</urlset>
